  "route_taxonomy": {
    "B1": "Compiler-inserted GPU current-live-allocation interval lookup without Shadow, address validity only (old I); B implementation variant",
    "B2": "Compiler-inserted GPU Shadow/Redzone, address validity only; recommended S01 initial B implementation",
    "D1": "Compiler-preserved original-object base/bounds (provenance) checked on actual GPU; A-to-live-B access coverage where known",
    "D2": "Pointer value plus allocation identity/epoch propagation, temporal provenance within declared ABI coverage",
    "C": "Independent UMD Runtime Binary Rewriter inserts GPU checker stubs in selected existing binaries; insertion time changes, not address-check guarantee by itself",
    "E": "Hybrid B/D/C module and ABI integration strategy, not independent address-check predicate",
    "F0": "Only auxiliary GPU MMU guard page (former G); never full independent object-byte sanitizer",
    "F1": "Actual hardware Tag mechanism only when silicon supports it; software tag method belongs to instrumented software checkers",
    "F2": "Actual hardware Bounds/metadata only if silicon supports it; otherwise separately scoped RTL/ASIC project"
  }
